# ============================================================
#  Variables de entorno — Plataforma de venta de chatbots
#  Copia este archivo a .env (local) o cárgalas en Vercel.
# ============================================================

# ---- Stripe (pagos / suscripción mensual) ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price IDs mensuales recurrentes, uno por plan (Stripe -> Products).
# STRIPE_PRICE_ID se usa como fallback del plan Pro si no defines STRIPE_PRICE_PRO.
STRIPE_PRICE_ID=price_xxx
STRIPE_PRICE_STARTER=price_starter_xxx
STRIPE_PRICE_PRO=price_pro_xxx
STRIPE_PRICE_BUSINESS=price_business_xxx

# ---- n8n (motor del chatbot) ----
# URL base de tu instancia n8n (ej: https://n8n.tudominio.com)
N8N_BASE_URL=https://n8n.tudominio.com
# API key de n8n: Settings -> n8n API
N8N_API_KEY=
# ID del workflow que actúa como bot (se puede sobreescribir por cliente)
N8N_DEFAULT_WORKFLOW_ID=

# ---- YCloud (WhatsApp) ----
YCLOUD_API_KEY=
# Número de WhatsApp emisor registrado en YCloud (formato E.164: +5215512345678)
YCLOUD_FROM_NUMBER=
# Webhook de n8n al que se reenvían los mensajes entrantes de WhatsApp
N8N_INBOUND_WEBHOOK_URL=
# Endpoint de YCloud que finaliza el onboarding del Embedded Signup (confírmalo con YCloud)
YCLOUD_ONBOARD_ENDPOINT=

# ---- Meta / Embedded Signup (conectar WhatsApp de tus clientes) ----
# App de Meta (Business) con WhatsApp + Facebook Login for Business.
META_APP_ID=
META_GRAPH_VERSION=v21.0
# config_id de la configuración de login para crear WABA / nuevo número
META_CONFIG_ID_SIGNUP=
# config_id de la configuración de login para Coexistence (app existente)
META_CONFIG_ID_COEXISTENCE=

# ---- Supabase (persistencia de clientes/suscripciones) ----
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
# URL pública del sitio (sin slash final). En Vercel: https://tu-proyecto.vercel.app
PUBLIC_BASE_URL=http://localhost:3000

# Token de API para los endpoints del panel (uso programático / compatibilidad).
ADMIN_TOKEN=

# ---- Login de dueño (Fase 1) ----
# Con esto entras a /login. Inventa una contraseña fuerte.
ADMIN_EMAIL=tu@correo.com
ADMIN_PASSWORD=
# Secreto para firmar la sesión (si lo dejas vacío usa ADMIN_PASSWORD). Pon uno largo y aleatorio.
SESSION_SECRET=
